{
	admin localhost:2019
	servers {
		protocols h1
	}
}

(losttofound_proxy) {
	encode zstd gzip

	# Google Search Console HTTPS ownership verification; retain across releases.
	@google_verification {
		host custodyfolio.com
		path /google3ac2616a1ec75406.html
	}
	handle @google_verification {
		header Content-Type "text/html; charset=utf-8"
		respond "google-site-verification: google3ac2616a1ec75406.html" 200
	}

	@health path /caddy-health
	handle @health {
		respond "ok" 200
	}

	header {
		-Server
		-X-Powered-By
	}

	@records_dataset_body path /api/records/dataset
	request_body @records_dataset_body {
		max_size 2MB
	}

	@records_api_body path /api/records/*
	request_body @records_api_body {
		max_size 12MB
	}

	@records_evidence_upload_body path /api/records/evidence/upload
	request_body @records_evidence_upload_body {
		max_size 11MB
	}

	handle {
		reverse_proxy losttofound:3000 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
			header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
		}
	}
}

http://:8080 {
	import losttofound_proxy
}
