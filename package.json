{
  "name": "custodyfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "npm run generate:policy-bundle",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:deploy": "bash deploy/production/test-health-recovery.sh",
    "test:attorney-access:production": "bash deploy/production/test-attorney-access.sh",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --config=playwright.webkit.config.ts",
    "test:e2e:webkit:attorney": "playwright test --config=playwright.webkit.config.ts --grep attorney",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:scan": "npm run security:secrets && npm run security:audit",
    "precheck:production": "npm run generate:policy-bundle",
    "check:production": "node scripts/check-production-readiness.mjs",
    "precheck:pre-supabase": "npm run generate:policy-bundle",
    "check:pre-supabase": "node scripts/check-production-readiness.mjs --pre-supabase",
    "check:live": "node scripts/check-live-readiness.mjs",
    "verify:env-template": "node scripts/verify-production-env-template.mjs",
    "verify:headers": "node scripts/verify-security-headers.mjs",
    "verify:edge-controls": "node scripts/verify-edge-controls.mjs",
    "verify:malware": "node scripts/verify-malware-scanner.mjs",
    "verify:isolation": "node scripts/verify-two-user-isolation.mjs",
    "verify:attorney-access": "node scripts/verify-attorney-access.mjs",
    "verify:supabase-auth": "node scripts/verify-supabase-auth-public-settings.mjs",
    "verify:security-events": "node scripts/verify-security-event-sink.mjs",
    "verify:backup-restore": "node scripts/verify-backup-restore-evidence.mjs",
    "verify:privacy-rights": "node scripts/verify-privacy-rights-request.mjs",
    "verify:apple-notifications": "node scripts/verify-apple-notifications-v2.mjs",
    "growth:scorecard": "node scripts/report-growth-scorecard.mjs",
    "test:growth-scorecard": "node --test scripts/growth-scorecard-lib.test.mjs scripts/growth-scorecard-migration.test.mjs",
    "indexnow:dry-run": "node scripts/submit-indexnow.mjs --dry-run",
    "test:indexnow": "node --test scripts/submit-indexnow.test.mjs",
    "audit:apple-billing": "node scripts/ios/audit-app-store-billing-readiness.mjs",
    "generate:policy-bundle": "node scripts/generate-production-policy-bundle.mjs",
    "approval:prepare": "npm run generate:policy-bundle && node scripts/create-production-approval-manifest.mjs",
    "preverify:approvals": "npm run generate:policy-bundle",
    "verify:approvals": "node scripts/verify-production-approval-manifest.mjs",
    "backup:storage": "node scripts/backup-supabase-storage.mjs",
    "verify:storage-backup": "node scripts/verify-supabase-storage-backup.mjs",
    "test:storage-backup": "node --test scripts/storage-backup-lib.test.mjs",
    "cleanup:retired-grant-bucket": "node scripts/delete-retired-grant-bucket.mjs",
    "ios:testflight": "bash scripts/ios/release-testflight.sh",
    "ios:testflight:dry-run": "bash scripts/ios/release-testflight.sh --dry-run",
    "ios:testflight:external": "node scripts/ios/distribute-testflight-external.mjs",
    "ios:testflight:verify": "node scripts/ios/distribute-testflight-external.mjs --verify-only",
    "test:ios:testflight": "node --test scripts/ios/distribute-testflight-external.test.mjs scripts/ios/audit-app-store-billing-readiness.test.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@aws-sdk/client-s3": "3.1107.0",
    "@radix-ui/react-icons": "1.3.2",
    "@supabase/supabase-js": "^2.86.2",
    "heic-to": "^1.5.2",
    "jspdf": "^4.2.1",
    "next": "^16.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.8.1",
    "sharp": "0.35.4",
    "stripe": "22.5.0",
    "vitest": "^4.1.11",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.22",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.18",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
